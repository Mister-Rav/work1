<section class="hero">
  <div class="container">
    <h1 class="hero-title">Интересные мероприятия</h1>
    <p class="hero-subtitle">
      Подписывайтесь на организаторов и направления — и видьте только то,
      что вам действительно интересно.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="feed">
      <% if (!feed || feed.length===0) { %>
        <p class="feed-empty">Пока нет предстоящих мероприятий. Загляните позже.</p>
        <% } else { %>
          <% feed.forEach(function (item) { %>
            <article class="feed-card">
              <a class="feed-card-link" href="/events/<%= item.id %>">
                <div class="feed-card-cover"></div>
                <div class="feed-card-body">
                  <div class="feed-card-date">
                    <%= item.date %>
                  </div>
                  <h3 class="feed-card-title">
                    <%= item.title %>
                  </h3>
                  <div class="feed-card-meta">
                    <%= item.city %> · <%= item.organizerName %>
                  </div>
                </div>
              </a>
            </article>
            <% }); %>
              <% } %>
    </div>
  </div>
</section>