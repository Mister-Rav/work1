{
  "name": "work1",
  "version": "0.1.0",
  "private": true,
  "description": "Платформа мероприятий для организаторов и участников",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copy:views",
    "copy:views": "copyfiles -u 1 \"src/views/**/*\" dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/view": "^12.0.1",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.1",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.5",
    "copyfiles": "^2.4.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}